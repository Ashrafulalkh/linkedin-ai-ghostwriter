# Google Gemini API Key
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (For ChatGPT models: GPT-4o, GPT-4o-mini, o3-mini)
# Obtain your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# xAI Grok API Key (For Grok models: grok-2-latest, grok-2, grok-beta, etc.)
# Obtain your key from https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here


# (Optional) If your server is in London/EU and hits location restrictions:
# Option A: Route through an HTTP/HTTPS Proxy
# HTTPS_PROXY=http://proxy-host:port

# Option B: Use Google Cloud Vertex AI backend
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=europe-west2

# LinkedIn OAuth Access Token (Optional for 1-Click Direct API Publishing)
# Needs 'w_member_social' permission from https://developer.linkedin.com/
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

